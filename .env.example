# ── Required
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database: local SQLite file for development; Supabase Postgres (Transaction pooler URL, port 6543) in production
DATABASE_URL=file:./prahari.db

# ── Email notifications for submissions / appointments / contact (optional; without SMTP emails are printed to the console)
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Spam protection: Cloudflare Turnstile (optional; honeypot + time-trap + rate-limit always on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Media storage on Vercel (optional locally; required on Vercel because its disk is not persistent)
BLOB_READ_WRITE_TOKEN=

# Set to false ONLY when running 'npm run build && npm start' locally against your dev database.
RUN_MIGRATIONS=

# ── Security (set these on Vercel)
# 1 = every staff login also needs an authenticator-app code (2-step). Leave empty locally.
REQUIRE_2FA=
# Vercel Cron sends this as a Bearer token to /api/cron/backup (any long random string)
CRON_SECRET=
# Encrypts the daily backup file. Keep a copy in a password manager — without it a backup cannot be opened.
BACKUP_KEY=

# ── Video storage: private S3-compatible bucket (Cloudflare R2 recommended). Empty = Vercel Blob / local files.
#    R2: Cloudflare dashboard → R2 → Create bucket (e.g. prahari-video) → "Manage R2 API Tokens" (Object Read & Write
#    on that bucket). Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com . Bucket CORS must allow PUT from the
#    website and expose the "ETag" header (resumable uploads) — run: node scripts/r2-cors.mjs
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# auto for R2; e.g. ap-south-1 for AWS
S3_REGION=auto

# ── Video processing. "external" = the separate worker (worker/Dockerfile, e.g. on Railway) does all jobs, no time
#    limit. Empty = jobs run right after the request on Vercel (max ~5 min: fine for short clips only).
VIDEO_WORKER=
# Worker only (the Docker image sets these): system ffmpeg and the Hindi font used for overlays
FFMPEG_PATH=
VIDEO_FONT=

# ── Female Hindi voice (Flash News). Pick ONE provider; empty = voice export off (preview uses the browser's voice).
#    google: Google Cloud → enable "Cloud Text-to-Speech API" → Credentials → API key (restrict it to that API).
#    azure:  Azure portal → Speech service → Keys and Endpoint (key + region, e.g. centralindia).
TTS_PROVIDER=
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# optional: voice name (google default hi-IN-Neural2-A, azure default hi-IN-SwaraNeural) and the cost note shown to editors
TTS_VOICE=
TTS_QUOTA_NOTE=

# ── Auto-share (official APIs only). A platform without its keys stays OFF; the Desk then offers
#    Copy caption + Download media + Open platform. WhatsApp: click-to-share links only (no keys).
# Telegram: talk to @BotFather → /newbot → token; add the bot as ADMIN of the channel; channel = @channelname
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
# Facebook PAGE (not a profile) + Instagram Business/Creator account linked to that Page:
# Meta for Developers → app → Page access token (long-lived) with pages_manage_posts, instagram_content_publish
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
# X: developer.x.com → app with Read+Write → API key/secret + Access token/secret (pay-per-use pricing applies)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
